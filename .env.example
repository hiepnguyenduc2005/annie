# Annie local deployment profile. Run from the repository root.
# Merge into an existing .env; never overwrite its credentials.
# Setup/status: docs/LOCAL_ENV.md. No cloud service is required by this profile.
# Graphiti/Ollama must be running; setting variables does not install services.
ANNIE_MODE=demo
ANNIE_DB_PATH=.data/annie.sqlite3
# Required for phone/LAN data access. Use a long random value, not this comment.
ANNIE_API_TOKEN=
ANNIE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# LOCAL VISION: installed Ollama Qwen alias with bounded 8192-token context.
# No API key is needed. GX10 can serve this boundary through a local tunnel.
ANNIE_VISION_MODE=local
ANNIE_VISION_BASE_URL=http://127.0.0.1:11434/v1
ANNIE_VISION_MODEL=annie-qwen3-vl:2b
ANNIE_VISION_API_KEY=
ANNIE_VISION_TIMEOUT_S=30
# Inbound brain auth inherits ANNIE_API_TOKEN unless separately configured.
# ANNIE_BRAIN_TOKEN=

# LOCAL MEMORY: Graphiti + FalkorDBLite + Ollama embeddings; SQLite still
# holds the app journal. Use local_sqlite to run without the Graphiti service.
ANNIE_MEMORY_PROVIDER=graphiti
ANNIE_GRAPHITI_URL=http://127.0.0.1:8005
# Optional local semantic recall in robot/app_backend; blank model = lexical.
ANNIE_EMBED_URL=http://127.0.0.1:11434
ANNIE_EMBED_MODEL=nomic-embed-text

# LOCAL ELASTIC: existing caption adapter, selected only after provisioning.
# Change ANNIE_MEMORY_PROVIDER above to elastic to use it INSTEAD OF Graphiti.
# HTTPS endpoint of your local node; key is generated on that node, no SaaS key.
# Pre-create the index with the mapping in docs/LOCAL_ENV.md.
ELASTIC_URL=https://localhost:9200
ELASTIC_API_KEY=
ELASTIC_CA_CERT=.data/elastic/http_ca.crt
ANNIE_MEMORY_INDEX=annie-sim-observations

# LOCAL VOICE: Whisper input + macOS say output are selected by launchers.
# ANNIE_AUDIO_ENABLED controls CLOUD MiMo transcription, not the local mic.
ANNIE_AUDIO_ENABLED=false
ANNIE_REQUIRE_AUDIO_RECEIPT=true
# Keep the existing cloud advisory path disabled for this local profile.
ANNIE_ENABLE_CLOUD_AGENTS=false

# Family message relay: app_backend dispatches to robot_backend on the LAN and
# receives progress events back at POST /internal/events. The IP WILL change
# between networks — this is the one place to change it. See
# contract/family_messages.md.
ROBOT_BACKEND_URL=
ANNIE_ROBOT_DISPATCH_TIMEOUT_S=3
# Shared secret for POST /internal/events; must match on both app_backend and
# robot_backend. Required — the endpoint rejects every request without it.
ANNIE_INTERNAL_SECRET=
# Demo/testing only: skip robot_backend entirely and run a canned event
# sequence, so the iOS app can be exercised with no GX10 and no dog.
ANNIE_FAMILY_MOCK_ROBOT=false

# Household records (profiles, messages, reminders, history, emergencies).
# Names confirmed by the backend owner and now implemented: app_backend reads
# MONGODB_URI and MONGODB_DB. Unset means an in-process fallback that is lost
# on restart; GET /api/storage reports which one is live.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=annie

# Deepgram, ElevenLabs, Linq and cloud databases are outside this local profile.
# DEEPGRAM_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # ElevenLabs voice for Annie (default Rachel)
# ELEVENLABS_API_KEY=
# LINQ_API_KEY=
