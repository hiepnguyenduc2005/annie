{
  "brain.perception": {
    "$defs": {
      "Pose": {
        "additionalProperties": false,
        "properties": {
          "map_id": {
            "default": "demo-home",
            "maxLength": 100,
            "minLength": 1,
            "title": "Map Id",
            "type": "string"
          },
          "x": {
            "title": "X",
            "type": "number"
          },
          "y": {
            "title": "Y",
            "type": "number"
          },
          "yaw": {
            "default": 0,
            "title": "Yaw",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "title": "Pose",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "caption": {
        "maxLength": 2000,
        "title": "Caption",
        "type": "string"
      },
      "confidence": {
        "maximum": 1,
        "minimum": 0,
        "title": "Confidence",
        "type": "number"
      },
      "frame_id": {
        "format": "uuid",
        "title": "Frame Id",
        "type": "string"
      },
      "location": {
        "enum": [
          "bed",
          "floor",
          "chair",
          "unknown"
        ],
        "title": "Location",
        "type": "string"
      },
      "model": {
        "anyOf": [
          {
            "maxLength": 200,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Model"
      },
      "person": {
        "title": "Person",
        "type": "boolean"
      },
      "pose": {
        "$ref": "#/$defs/Pose"
      },
      "posture": {
        "enum": [
          "standing",
          "sitting",
          "lying",
          "unknown"
        ],
        "title": "Posture",
        "type": "string"
      },
      "schema_version": {
        "const": "0.1",
        "default": "0.1",
        "title": "Schema Version",
        "type": "string"
      },
      "source": {
        "default": "mock",
        "enum": [
          "mock",
          "simulation_ground_truth",
          "simulation_vlm",
          "hardware_vlm"
        ],
        "title": "Source",
        "type": "string"
      },
      "ts": {
        "minimum": 0,
        "title": "Ts",
        "type": "integer"
      }
    },
    "required": [
      "ts",
      "frame_id",
      "person",
      "posture",
      "location",
      "confidence",
      "caption",
      "pose"
    ],
    "title": "Perception",
    "type": "object"
  },
