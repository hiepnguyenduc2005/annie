QWEN_BASE_URL=http://127.0.0.1:8091
QWEN_MODEL=Qwen/Qwen2.5-Omni-3B
QWEN_REQUEST_TIMEOUT=180
# Speech goes to Deepgram; Qwen handles text reasoning.
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_LANGUAGE=en
DEEPGRAM_REQUEST_TIMEOUT=30
# Exact POST endpoint. Empty = retain final summaries in the local outbox.
DEDICATED_SERVER_URL=
DEDICATED_SERVER_API_KEY=
# Distinct inbound bearer tokens; set both before exposing the service on a LAN.
PHONE_API_KEY=
SERVER_API_KEY=
SESSION_TIMEOUT_SECONDS=900
SESSION_RETENTION_SECONDS=86400
MAX_SESSIONS=256
HISTORY_TURNS=6
MAX_UPLOAD_BYTES=10485760
OUTBOX_PATH=.data/companion-outbox.sqlite3
DELIVERY_TIMEOUT_SECONDS=10
MAINTENANCE_INTERVAL_SECONDS=5
