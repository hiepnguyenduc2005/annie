# Synthetic local demo; actual .env files are ignored by Git.
ANNIE_MODE=demo
ANNIE_DB_PATH=.data/annie.sqlite3
# Required for phone/LAN data access. Use a long random value, not this comment.
ANNIE_API_TOKEN=
ANNIE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional cloud advisory team. No live calls occur until enabled AND requested.
SUBCONSCIOUS_API_KEY=
SUBCONSCIOUS_MODEL=subconscious/glm-5.3-marathon
ANNIE_ENABLE_CLOUD_AGENTS=false

# Reserved for future hardware/service adapters; not used by the current demo.
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# LINQ_API_KEY=
# ELASTIC_URL=
# ELASTIC_API_KEY=

# Optional GX10-compatible brain. Cloud mode accepts synthetic simulation only.
ANNIE_VISION_MODE=disabled
ANNIE_VISION_BASE_URL=https://openrouter.ai/api/v1
ANNIE_VISION_MODEL=google/gemini-2.5-flash-lite:floor
# Runtime launcher maps OPENROUTER_API_KEY when using that host.
ANNIE_VISION_API_KEY=
ANNIE_BRAIN_TOKEN=
ANNIE_VISION_TIMEOUT_S=30
ANNIE_VISION_MAX_CLOUD_CALLS=100
ANNIE_VISION_BUDGET_USD=20
ANNIE_VISION_USAGE_PATH=.data/vision-usage.json
ANNIE_AUDIO_ENABLED=false
ANNIE_REQUIRE_AUDIO_RECEIPT=true
# Local alternative: mode=local, base=http://127.0.0.1:11434/v1,
# model=qwen3-vl:2b-instruct; no external call or provider key.
