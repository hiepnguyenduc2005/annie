// Shared build defaults for SpeakerMic.xcodeproj (independent of app_frontend).
// Per-machine signing goes in Local.xcconfig, which is gitignored:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   PRODUCT_BUNDLE_IDENTIFIER = com.yourname.annie-audio
//
// (Or just pick a Team under Signing & Capabilities in Xcode.)
PRODUCT_BUNDLE_IDENTIFIER = app.annie.audio
// Override these in Local.xcconfig for a physical phone. The default is for Simulator.
// Use ws:/$()/HOST:8080/audio so xcconfig does not interpret // as a comment.
ANNIE_AUDIO_SERVER_URL = ws:/$()/127.0.0.1:8080/audio
ANNIE_PHONE_API_KEY =
#include? "Local.xcconfig"
