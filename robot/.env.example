# Local robot demo profile. Launchers read the ROOT .env, not robot/.env.
# See ../.env.example and ../docs/LOCAL_ENV.md for the full local setup.
ANNIE_MODE=demo
ANNIE_DB_PATH=.data/annie.sqlite3
# Required for phone/LAN data access. Use a long random value, not this comment.
ANNIE_API_TOKEN=
ANNIE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Local profile: optional cloud advisory code stays disabled.
ANNIE_ENABLE_CLOUD_AGENTS=false

# Local graph memory already used by the story demo.
ANNIE_MEMORY_PROVIDER=graphiti
ANNIE_GRAPHITI_URL=http://127.0.0.1:8005
ANNIE_EMBED_URL=http://127.0.0.1:11434
ANNIE_EMBED_MODEL=nomic-embed-text
# Optional local Elasticsearch; provision before selecting provider=elastic.
ELASTIC_URL=https://localhost:9200
ELASTIC_API_KEY=
ELASTIC_CA_CERT=.data/elastic/http_ca.crt
ANNIE_MEMORY_INDEX=annie-sim-observations

# Local Ollama brain; create the alias with prepare_local_brain.py if needed.
ANNIE_VISION_MODE=local
ANNIE_VISION_BASE_URL=http://127.0.0.1:11434/v1
ANNIE_VISION_MODEL=annie-qwen3-vl:2b
ANNIE_VISION_API_KEY=
# ANNIE_BRAIN_TOKEN=  # otherwise inherits ANNIE_API_TOKEN
ANNIE_VISION_TIMEOUT_S=30
# This flag controls cloud transcription, not local Whisper/microphone input.
ANNIE_AUDIO_ENABLED=false
ANNIE_REQUIRE_AUDIO_RECEIPT=true
