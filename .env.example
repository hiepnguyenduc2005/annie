# Synthetic local demo; actual .env files are ignored by Git.
ANNIE_MODE=demo
ANNIE_DB_PATH=.data/annie.sqlite3
# Required for phone/LAN data access. Use a long random value, not this comment.
ANNIE_API_TOKEN=
ANNIE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional cloud advisory team. No live calls occur until enabled AND requested.
SUBCONSCIOUS_API_KEY=
SUBCONSCIOUS_MODEL=subconscious/glm-5.3-marathon
ANNIE_ENABLE_CLOUD_AGENTS=false

# Family message relay: app_backend dispatches to robot_backend on the LAN and
# receives progress events back at POST /internal/events. The IP WILL change
# between networks — this is the one place to change it. See
# contract/family_messages.md.
ROBOT_BACKEND_URL=
ANNIE_ROBOT_DISPATCH_TIMEOUT_S=3
# Shared secret for POST /internal/events; must match on both app_backend and
# robot_backend. Required — the endpoint rejects every request without it.
ANNIE_INTERNAL_SECRET=
# Demo/testing only: skip robot_backend entirely and run a canned event
# sequence, so the iOS app can be exercised with no GX10 and no dog.
ANNIE_FAMILY_MOCK_ROBOT=false

# Reserved for future hardware/service adapters; not used by the current demo.
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# LINQ_API_KEY=
# ELASTIC_URL=
# ELASTIC_API_KEY=
